# Raw/interim/processed data (regenerable, and the real files are large)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Trained artifacts
outputs/checkpoints/*
!outputs/checkpoints/.gitkeep
outputs/metrics/*
!outputs/metrics/.gitkeep
outputs/explanations/*
!outputs/explanations/.gitkeep
outputs/reports/*
!outputs/reports/.gitkeep

__pycache__/
*.pyc
.pytest_cache/
.venv/
*.egg-info/

# Colab upload bundle (regenerable from the sources; not a source file)
colab/gnn_aml_code.zip
